<?xml version="1.0" encoding="UTF-8"?>
<!-- The fields of the record. The entity extending it names the table and its indexes. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="FlorentinGarnier\CookieConsent\ConsentRecord">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="consentId" column="consent_id" type="string" length="36"/>
        <field name="policyVersion" column="policy_version" type="string" length="64"/>
        <field name="categories" type="json"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <field name="channelCode" column="channel_code" type="string" nullable="true"/>
    </mapped-superclass>
</doctrine-mapping>
